{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      "$code": {
        ".read": true,
        ".write": "auth != null && newData.exists()",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name', 'members', 'exp', 'round'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "code": {
          ".validate": "newData.val() === $code"
        },
        "members": {
          "$uid": {
            ".validate": "$uid.matches(/^[a-z0-9]{1,32}$/) && newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "round": {
          ".validate": "newData.hasChild('id') && newData.hasChild('phase')",
          "id": {
            ".validate": "newData.isNumber()"
          },
          "phase": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          }
        },
        "log": {
          "$i": {
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            }
          }
        }
      }
    },
    "answers": {
      "$code": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        "$rid": {
          ".validate": "$rid.matches(/^[0-9]{1,9}$/)",
          "_talk": {
            "$msg": {
              ".validate": "newData.hasChildren(['uid', 'text', 'at'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "$other": {
                ".validate": "$other === 'uid' || $other === 'at'"
              }
            }
          },
          "$uid": {
            ".validate": "$uid.matches(/^[a-z0-9]{1,32}$/) && newData.hasChildren(['roundId', 'uid', 'at'])",
            "choice": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "$other": {
              ".validate": "$other === 'roundId' || $other === 'uid' || $other === 'at'"
            }
          }
        }
      }
    },
    "presence": {
      "$code": {
        ".read": true,
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",
        "$uid": {
          ".write": "auth != null",
          ".validate": "$uid.matches(/^[a-z0-9]{1,32}$/) && newData.isNumber()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous'",
        ".validate": "newData.hasChild('pid')",
        "pid": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "since": {
          ".validate": "newData.isNumber()"
        },
        "teams": {
          ".validate": "newData.hasChildren() || !newData.exists()"
        },
        "profile": {
          ".validate": "newData.hasChildren() || !newData.exists()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lb": {
      "$m": {
        ".validate": "$m.matches(/^[a-z]{2,20}$/)",
        ".read": true,
        ".indexOn": [
          "ms"
        ],
        "$code": {
          ".write": "auth != null",
          ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name','ms','at']) && (!data.exists() || newData.child('ms').val() <= data.child('ms').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "right": {
            ".validate": "newData.isNumber()"
          },
          "q": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "lbw": {
      "$week": {
        ".validate": "$week.matches(/^w[0-9]{4,6}$/)",
        "$m": {
          ".validate": "$m.matches(/^[a-z]{2,20}$/)",
          ".read": true,
          ".indexOn": [
            "ms"
          ],
          "$code": {
            ".write": "auth != null",
            ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name','ms','at']) && (!data.exists() || newData.child('ms').val() <= data.child('ms').val())",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "right": {
              ".validate": "newData.isNumber()"
            },
            "q": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "lbd": {
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        ".read": true,
        ".indexOn": [
          "ms"
        ],
        "$code": {
          ".write": "auth != null",
          ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name','ms','at']) && (!data.exists() || newData.child('ms').val() <= data.child('ms').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "right": {
            ".validate": "newData.isNumber()"
          },
          "q": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
